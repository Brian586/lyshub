rules_version = '2';

// lyshub.com — projects managed in /admin, read by the public site.
//
// admins/{uid}                     who may manage projects. Created by hand in the console;
//                                  nobody can write it from the browser.
// projects/{id}                    readable by anyone once published; drafts only by admins.
// projects/{id}/chunks/{chunk}     the bytes of each flyer and video, readable when the
//                                  project is published.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function published(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data.published == true;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /projects/{projectId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.published is bool;
      allow delete: if isAdmin();

      match /chunks/{chunkId} {
        allow read: if isAdmin() || published(projectId);
        allow create, update: if isAdmin()
          && request.resource.data.data is bytes
          && request.resource.data.n is int;
        allow delete: if isAdmin();
      }
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
